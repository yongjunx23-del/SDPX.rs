#!/bin/bash
# Generic bounded native Ising campaign launcher.
#
# The native CLI and its settings are frozen before submission.  This script
# deliberately does not build a Julia/FFI arm or contain a historical campaign
# directory/node name.  Set SDPX_ISING_CONFIG and SDPX_ISING_OUTPUT in the job
# environment (or edit those two explicit paths for a reviewed snapshot).
# Numerical cells remain serialized by scaling.py's research slot lock.
#PBS -N sdpx_native_ising
#PBS -q normal
#PBS -l nodes=1:ppn=8
#PBS -l mem=48gb
#PBS -l walltime=04:00:00
#PBS -j oe
set -euo pipefail

: "${SDPX_ISING_CONFIG:?set SDPX_ISING_CONFIG to the frozen native CLI config}"
: "${SDPX_ISING_OUTPUT:?set SDPX_ISING_OUTPUT outside the source tree}"
PROJECT_ROOT="${SDPX_PROJECT_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
WIDTHS="${SDPX_ISING_WIDTHS:-1,2,4,8}"
CAMPAIGN_SECONDS="${SDPX_ISING_SECONDS:-600}"
CELL_SECONDS="${SDPX_ISING_CELL_SECONDS:-180}"
REPETITIONS="${SDPX_ISING_REPETITIONS:-1}"
MEMORY_MIB="${SDPX_ISING_MEMORY_MIB:-4096}"

cd "$PROJECT_ROOT"
python3 benchmark/ising/scaling.py \
  --config "$SDPX_ISING_CONFIG" \
  --output "$SDPX_ISING_OUTPUT" \
  --widths "$WIDTHS" \
  --repetitions "$REPETITIONS" \
  --seconds "$CAMPAIGN_SECONDS" \
  --cell-seconds "$CELL_SECONDS" \
  --memory-mib "$MEMORY_MIB"
